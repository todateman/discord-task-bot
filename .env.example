# Discord
DISCORD_TOKEN=your_discord_bot_token_here
TASK_CHANNELS=task-todo,task-dev,task-ops   # カンマ区切りで複数指定（空にすると全チャンネル監視）
REPORT_CHANNEL=general                      # 週次レポートを投稿するチャンネル名

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets
SPREADSHEET_ID=your_spreadsheet_id_here    # URLの /d/XXXXX/edit の XXXXX 部分
SHEET_NAME=タスク一覧
CREDENTIALS_FILE=credentials.json          # サービスアカウントJSONのパス
